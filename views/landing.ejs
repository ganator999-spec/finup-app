<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FinUp | Smart Personal Finance</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="landing-page">
  <div class="landing-wrapper">
    <header class="landing-header">
      <a class="brand" href="/">
        <span class="brand-icon">✦</span>
        <span class="brand-text">FinUp</span>
      </a>

      <nav class="landing-nav">
        <a href="#features">Features</a>
        <a href="#workflow">How it works</a>
        <a href="#insights">Insights</a>
      </nav>

      <div class="landing-header-actions">
        <a class="login-link" href="/login">Login</a>
        <a class="header-cta" href="/onboard">Start free</a>
      </div>
    </header>

    <main class="landing-main">
      <section class="hero-section">
        <div class="hero-copy">
          <span class="hero-kicker">Smart financial clarity</span>
          <h1>Turn everyday money decisions into real progress.</h1>
          <p class="hero-subtitle">
            FinUp helps you understand your spending, plan your savings,
            and move confidently toward goals that matter.
          </p>

          <div class="hero-actions">
            <a class="primary-button" href="/onboard">Create your free account</a>
            <a class="secondary-button" href="#features">See how it works</a>
          </div>

          <div class="hero-proof">
            <div>
              <span class="proof-number">360°</span>
              <span class="proof-label">Money view</span>
            </div>
            <div>
              <span class="proof-number">24/7</span>
              <span class="proof-label">Insights</span>
            </div>
            <div>
              <span class="proof-number">1</span>
              <span class="proof-label">Financial plan</span>
            </div>
          </div>
        </div>

        <aside class="hero-panel">
          <div class="panel-card">
            <div class="panel-card-top">
              <span class="panel-label">Monthly Snapshot</span>
              <span class="panel-status">+12.8%</span>
            </div>

            <div class="panel-amount">
              <span class="amount-label">Available Balance</span>
              <span class="amount-value">$8,420.25</span>
            </div>

            <div class="panel-bars">
              <div class="bar-row">
                <span class="bar-label">Housing</span>
                <div class="bar-track">
                  <div class="bar-fill bar-fill-one" style="width: 72%;"></div>
                </div>
                <span class="bar-value">$720</span>
              </div>

              <div class="bar-row">
                <span class="bar-label">Savings</span>
                <div class="bar-track">
                  <div class="bar-fill bar-fill-two" style="width: 58%;"></div>
                </div>
                <span class="bar-value">$580</span>
              </div>

              <div class="bar-row">
                <span class="bar-label">Lifestyle</span>
                <div class="bar-track">
                  <div class="bar-fill bar-fill-three" style="width: 44%;"></div>
                </div>
                <span class="bar-value">$440</span>
              </div>
            </div>

            <div class="mini-grid">
              <div class="mini-card">
                <span class="mini-label">Income</span>
                <span class="mini-value">$4,920</span>
              </div>
              <div class="mini-card">
                <span class="mini-label">Expenses</span>
                <span class="mini-value">$2,390</span>
              </div>
            </div>

            <div class="goal-card">
              <div>
                <span class="goal-label">Savings Goal</span>
                <span class="goal-title">Emergency Fund</span>
              </div>
              <div class="goal-progress">
                <div class="goal-progress-track">
                  <div class="goal-progress-fill" style="width: 76%;"></div>
                </div>
                <span class="goal-percent">76%</span>
              </div>
            </div>
          </div>
        </aside>
      </section>

      <section class="feature-section" id="features">
        <div class="section-heading centered">
          <span class="section-kicker">The FinUp system</span>
          <h2>Everything your financial life needs.</h2>
        </div>

        <div class="feature-grid">
          <article class="feature-card">
            <span class="feature-icon">↗</span>
            <h3>Budget planning</h3>
            <p>Build a budget that matches your lifestyle and gives your spending a clear direction.</p>
          </article>

          <article class="feature-card">
            <span class="feature-icon">◎</span>
            <h3>Goal tracking</h3>
            <p>Turn goals into visible milestones and understand how each month moves you forward.</p>
          </article>

          <article class="feature-card">
            <span class="feature-icon">☄</span>
            <h3>Smart insights</h3>
            <p>Spot patterns in income and expenses before they become bigger financial decisions.</p>
          </article>
        </div>
      </section>

      <section class="workflow-section" id="workflow">
        <div class="section-heading">
          <span class="section-kicker">How it works</span>
          <h2>From first question to confident plan.</h2>
        </div>

        <div class="workflow-grid">
          <div class="workflow-step">
            <span class="step-number">01</span>
            <div>
              <h3>Create your profile</h3>
              <p>Start with the basics and invite your financial picture into one place.</p>
            </div>
          </div>

          <div class="workflow-step">
            <span class="step-number">02</span>
            <div>
              <h3>Connect your activity</h3>
              <p>Bring in transactions, budget categories, and spending patterns.</p>
            </div>
          </div>

          <div class="workflow-step">
            <span class="step-number">03</span>
            <div>
              <h3>Track progress</h3>
              <p>See where you are, where you are headed, and what to improve next.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="insights-section" id="insights">
        <div class="insights-card">
          <div class="insights-copy">
            <span class="section-kicker">Financial progress</span>
            <h2>Know where your money is going before it becomes a problem.</h2>
            <p>
              FinUp turns data into simple next steps so your financial habits become easier to manage.
            </p>
            <a class="primary-button small-button" href="/onboard">Build my plan</a>
          </div>
          <div class="insights-chart">
            <div class="chart-card">
              <span class="chart-label">Spending health</span>
              <span class="chart-score">88%</span>
              <div class="chart-bars">
                <span class="chart-bar chart-bar-one"></span>
                <span class="chart-bar chart-bar-two"></span>
                <span class="chart-bar chart-bar-three"></span>
                <span class="chart-bar chart-bar-four"></span>
                <span class="chart-bar chart-bar-five"></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="cta-section">
        <div class="cta-content">
          <span class="section-kicker">Start with clarity</span>
          <h2>Make your next financial decision with confidence.</h2>
        </div>
        <div class="cta-actions">
          <a class="primary-button" href="/onboard">Create free account</a>
        </div>
      </section>
    </main>

    <footer class="landing-footer">
      <a class="brand" href="/">
        <span class="brand-icon">✦</span>
        <span class="brand-text">FinUp</span>
      </a>
      <span class="footer-copy">© 2026 FinUp. Personal finance, redesigned.</span>
    </footer>
  </div>
</body>
</html>
</body>
</html>
