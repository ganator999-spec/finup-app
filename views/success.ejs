<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to FinUp</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="success-page">
    <div class="success-container">
        <div class="success-card">
            <div class="success-icon">✅</div>
            <h1>Welcome to FinUp</h1>
            <p style="color: #86868b; margin-bottom: 24px;">Your account has been created successfully, <%= client.firstName %>!</p>

            <div class="client-summary">
                <div style="display: grid; grid-template-columns: 1fr; gap: 12px;">
                    <div>
                        <p style="font-size: 12px; color: #86868b; text-transform: uppercase; margin-bottom: 4px;">Email</p>
                        <p style="margin: 0; color: #1d1d1f;"><%= client.email %></p>
                    </div>
                    <div>
                        <p style="font-size: 12px; color: #86868b; text-transform: uppercase; margin-bottom: 4px;">Company</p>
                        <p style="margin: 0; color: #1d1d1f;"><%= client.company %></p>
                    </div>
                    <div>
                        <p style="font-size: 12px; color: #86868b; text-transform: uppercase; margin-bottom: 4px;">Member Since</p>
                        <p style="margin: 0; color: #1d1d1f;"><%= new Date(client.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                    </div>
                </div>
            </div>

            <p style="color: #a1a1a6; font-size: 13px; margin-top: 20px;">Redirecting to your dashboard...</p>

            <div class="action-buttons">
                <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
                <a href="/logout" class="btn btn-secondary">Sign Out</a>
            </div>
        </div>
    </div>

    <script>
        setTimeout(() => {
            window.location.href = '/dashboard';
        }, 3000);
    </script>
</body>
</html>