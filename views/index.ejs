<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account - FinUp</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="onboarding-page">
    <div class="onboarding-shell">
        <div class="form-container onboarding-form-container">
            <h1>👋 Create Account</h1>
            <p class="subtitle">Join FinUp and take control of your finances. Fill out your information to get started.</p>

            <% if (typeof errors !== 'undefined') { %>
                <div class="error-message">
                    <% Object.values(errors).forEach(error => { %>
                        <p>⚠️ <%= error.message %></p>
                    <% }) %>
                </div>
            <% } %>

            <form action="/onboard" method="POST" class="onboarding-form">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="firstName">First Name</label>
                        <input type="text" id="firstName" name="firstName" 
                               value="<%= clientData?.firstName || '' %>" required>
                    </div>

                    <div class="form-group">
                        <label for="lastName">Last Name</label>
                        <input type="text" id="lastName" name="lastName" 
                               value="<%= clientData?.lastName || '' %>" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" 
                               value="<%= clientData?.email || '' %>" placeholder="you@example.com" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="phone">Phone</label>
                        <input type="tel" id="phone" name="phone" 
                               value="<%= clientData?.phone || '' %>" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="company">Company</label>
                        <input type="text" id="company" name="company" 
                               value="<%= clientData?.company || '' %>" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="position">Position</label>
                        <input type="text" id="position" name="position" 
                               value="<%= clientData?.position || '' %>">
                    </div>
                </div>

                <div class="address-section">
                    <h3>📍 Address</h3>
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label for="street">Street</label>
                            <input type="text" id="street" name="street" 
                                   value="<%= clientData?.address?.street || '' %>">
                        </div>

                        <div class="form-group">
                            <label for="city">City</label>
                            <input type="text" id="city" name="city" 
                                   value="<%= clientData?.address?.city || '' %>">
                        </div>

                        <div class="form-group">
                            <label for="state">State</label>
                            <input type="text" id="state" name="state" 
                                   value="<%= clientData?.address?.state || '' %>">
                        </div>

                        <div class="form-group">
                            <label for="zipCode">ZIP Code</label>
                            <input type="text" id="zipCode" name="zipCode" 
                                   value="<%= clientData?.address?.zipCode || '' %>">
                        </div>

                        <div class="form-group full-width">
                            <label for="country">Country</label>
                            <input type="text" id="country" name="country" 
                                   value="<%= clientData?.address?.country || '' %>">
                        </div>
                    </div>
                </div>

                <div class="security-section">
                    <h3>🔒 Create Password</h3>
                    <div class="form-group full-width">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" 
                               placeholder="Minimum 6 characters" required>
                    </div>
                    <div class="form-group full-width">
                        <label for="confirmPassword">Confirm Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" 
                               placeholder="Re-enter your password" required>
                    </div>
                </div>

                <button type="submit" class="submit-btn">Create Account</button>
            </form>

            <div class="form-footer">
                <p>Already have an account? <a href="/login">Sign in here</a></p>
            </div>
        </div>
    </div>

    <script>
        const onboardingForm = document.querySelector('.onboarding-form');
        if (onboardingForm) {
            onboardingForm.addEventListener('submit', function(e) {
                const password = document.getElementById('password').value;
                const confirmPassword = document.getElementById('confirmPassword').value;
                
                if (password !== confirmPassword) {
                    e.preventDefault();
                    alert('Passwords do not match. Please try again.');
                }
            });
        }
    </script>
</body>
</html>