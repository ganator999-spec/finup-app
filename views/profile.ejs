<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - FinUp</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="profile-page">
    <div class="dashboard-wrapper">
        <nav class="navbar">
            <div class="navbar-content">
                <h2>👤 FinUp Profile</h2>
                <div class="navbar-actions">
                    <a href="/dashboard" class="nav-link">← Back to Dashboard</a>
                    <a href="/billing" class="nav-link">🧾 Bill Builder</a>
                    <a href="/upload" class="nav-link">📎 Upload Preview</a>
                    <a href="/logout" class="logout-btn">🚪 Logout</a>
                </div>
            </div>
        </nav>

        <div class="container">
            <div class="dashboard-container">
                <h1>Your Profile Information</h1>

                <div class="profile-grid">
                    <!-- Personal Information -->
                    <div class="profile-card">
                        <h3>📋 Personal Information</h3>
                        <div class="profile-info-grid">
                            <div class="profile-info-item">
                                <label>First Name</label>
                                <p><%= client.firstName %></p>
                            </div>
                            <div class="profile-info-item">
                                <label>Last Name</label>
                                <p><%= client.lastName %></p>
                            </div>
                            <div class="profile-info-item full-width">
                                <label>Email</label>
                                <p><%= client.email %></p>
                            </div>
                            <div class="profile-info-item full-width">
                                <label>Phone</label>
                                <p><%= client.phone %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Professional Information -->
                    <div class="profile-card">
                        <h3>💼 Professional Information</h3>
                        <div class="profile-info-grid">
                            <div class="profile-info-item full-width">
                                <label>Company</label>
                                <p><%= client.company %></p>
                            </div>
                            <div class="profile-info-item full-width">
                                <label>Position</label>
                                <p><%= client.position %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <div class="profile-card">
                        <h3>📍 Address</h3>
                        <div class="profile-info-grid">
                            <div class="profile-info-item full-width">
                                <label>Street</label>
                                <p><%= client.address.street %></p>
                            </div>
                            <div class="profile-info-item">
                                <label>City</label>
                                <p><%= client.address.city %></p>
                            </div>
                            <div class="profile-info-item">
                                <label>State</label>
                                <p><%= client.address.state %></p>
                            </div>
                            <div class="profile-info-item">
                                <label>Zip Code</label>
                                <p><%= client.address.zipCode %></p>
                            </div>
                            <div class="profile-info-item full-width">
                                <label>Country</label>
                                <p><%= client.address.country %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Account Status -->
                    <div class="profile-card">
                        <h3>ℹ️ Account Status</h3>
                        <div class="profile-info-grid">
                            <div class="profile-info-item">
                                <label>Account Created</label>
                                <p><%= new Date(client.createdAt).toLocaleDateString() %></p>
                            </div>
                            <div class="profile-info-item">
                                <label>Member Since</label>
                                <p><%= new Date(client.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="profile-actions">
                    <a href="/edit-profile" class="action-btn primary-btn">✏️ Edit Profile</a>
                    <a href="/dashboard" class="action-btn secondary-btn">📊 Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>

    <style>
        .dashboard-wrapper {
            min-height: 100vh;
            background:
                radial-gradient(circle at 78% 10%, rgba(190, 238, 210, 0.8), transparent 16%),
                linear-gradient(135deg, #eefbf3 0%, #dcefe7 100%);
            color: #10251f;
        }

        .navbar {
            background: #10251f;
            color: #eefbf3;
            box-shadow: 0 12px 30px rgba(16, 37, 31, 0.12);
        }

        .navbar-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 24px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h2 {
            margin: 0;
            font-size: 26px;
            font-weight: 900;
            letter-spacing: -0.02em;
        }

        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .nav-link {
            color: #eefbf3;
            text-decoration: none;
            transition: opacity 0.3s ease;
            font-weight: 700;
        }

        .nav-link:hover {
            opacity: 0.82;
        }

        .logout-btn {
            background: #eefbf3;
            color: #10251f;
            padding: 10px 20px;
            border-radius: 999px;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid rgba(255,255,255,0.7);
            font-weight: 800;
        }

        .logout-btn:hover {
            background: #dff7ea;
        }

        .profile-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .profile-card {
            background: rgba(255,255,255,0.92);
            border-radius: 22px;
            padding: 30px;
            box-shadow: 0 12px 32px rgba(16,37,31,0.09);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(16,37,31,0.08);
        }

        .profile-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 34px rgba(16,37,31,0.12);
        }

        .profile-card h3 {
            color: #0f7b54;
            margin-bottom: 20px;
            font-size: 18px;
            font-weight: 800;
            border-bottom: 2px solid #0f7b54;
            padding-bottom: 10px;
        }

        .profile-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .profile-info-item {
            display: flex;
            flex-direction: column;
        }

        .profile-info-item.full-width {
            grid-column: 1 / -1;
        }

        .profile-info-item label {
            font-weight: 600;
            color: #666;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .profile-info-item p {
            color: #333;
            font-size: 16px;
            margin: 0;
            line-height: 1.5;
        }

        .profile-actions {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .action-btn {
            padding: 12px 24px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 800;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .primary-btn {
            background: #10251f;
            color: #eefbf3;
        }

        .primary-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 22px rgba(16,37,31,0.2);
        }

        .secondary-btn {
            background: #eefbf3;
            color: #10251f;
            border: 1px solid #10251f;
        }

        .secondary-btn:hover {
            background: #dff7ea;
            color: #10251f;
        }
    </style>
</body>
</html>
