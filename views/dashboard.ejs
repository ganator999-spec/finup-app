<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - FinUp</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="dashboard-page">
    <div class="dashboard-wrapper">
        <nav class="navbar">
            <div class="navbar-content">
                <h2>💰 FinUp Dashboard</h2>
                <div class="navbar-actions">
                    <span class="user-greeting">Welcome, <%= client.firstName %></span>
                    <% if (!client.zohoAccessToken) { %>
                        <a href="/auth/zoho" class="nav-link connect-zoho">🔗 Connect Zoho Analytics</a>
                    <% } else { %>
                        <span class="zoho-connected">✅ Zoho Connected</span>
                        <a href="/auth/zoho" class="nav-link reconnect-zoho">Reconnect</a>
                    <% } %>
                    <a href="/billing" class="nav-link">🧾 Bill Builder</a>
                    <a href="/profile" class="nav-link">👤 Profile</a>
                    <a href="/logout" class="logout-btn">🚪 Logout</a>
                </div>
            </div>
        </nav>

        <div class="container">
            <div class="dashboard-container" id="dashboard-content">
                <!-- Loading State -->
                <div class="loading-state" id="loading">
                    <div class="loading-spinner"></div>
                    <p>Loading your financial data...</p>
                </div>

                <!-- Dashboard Content (populated by JavaScript) -->
                <div class="dashboard-content" id="dashboard-main">
                <!-- Account Summary Cards -->
                <div class="cards-grid">
                    <div class="card account-card">
                        <div class="card-header">
                            <h3>Account Balance</h3>
                            <span class="card-icon">💳</span>
                        </div>
                        <div class="card-amount"><span class="loading-skeleton loading-value"></span></div>
                        <p class="card-label">Total Available</p>
                    </div>

                    <div class="card income-card">
                        <div class="card-header">
                            <h3>Monthly Income</h3>
                            <span class="card-icon">📈</span>
                        </div>
                        <div class="card-amount"><span class="loading-skeleton loading-value"></span></div>
                        <p class="card-label">This Month</p>
                    </div>

                    <div class="card expense-card">
                        <div class="card-header">
                            <h3>Monthly Expenses</h3>
                            <span class="card-icon">📉</span>
                        </div>
                        <div class="card-amount"><span class="loading-skeleton loading-value"></span></div>
                        <p class="card-label">This Month</p>
                    </div>

                    <div class="card savings-card">
                        <div class="card-header">
                            <h3>Savings Goal</h3>
                            <span class="card-icon">🎯</span>
                        </div>
                        <div class="card-amount"><span class="loading-skeleton loading-value"></span></div>
                        <p class="card-label">Progress</p>
                    </div>
                </div>

                <!-- Analytics Section -->
                <div class="analytics-section">
                    <h2>📊 Financial Overview</h2>

                    <div class="analytics-grid">
                        <!-- Spending by Category -->
                        <div class="analytics-card">
                            <h3>Spending by Category</h3>
                            <div class="category-list loading-list">
                                <div class="loading-skeleton loading-row"></div>
                                <div class="loading-skeleton loading-row"></div>
                                <div class="loading-skeleton loading-row"></div>
                            </div>
                        </div>

                        <!-- Recent Transactions -->
                        <div class="analytics-card">
                            <h3>Recent Transactions</h3>
                            <div class="transactions-list loading-list">
                                <div class="loading-skeleton loading-row"></div>
                                <div class="loading-skeleton loading-row"></div>
                                <div class="loading-skeleton loading-row"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Health & Goals -->
                    <div class="analytics-grid">
                        <div class="analytics-card">
                            <h3>💪 Financial Health</h3>
                            <div class="health-metrics">
                                <div class="health-item">
                                    <span class="health-label">Credit Score</span>
                                    <div class="health-score health-unavailable">Not available</div>
                                    <div class="health-bar">
                                        <div class="health-progress health-unavailable-bar"></div>
                                    </div>
                                </div>
                                <div class="health-item">
                                    <span class="health-label">Savings Rate</span>
                                    <div class="health-score"><span class="loading-skeleton loading-small-value" data-health-savings></span></div>
                                    <div class="health-bar">
                                        <div class="loading-skeleton loading-progress" data-health-savings-bar></div>
                                    </div>
                                </div>
                                <div class="health-item">
                                    <span class="health-label">Debt-to-Income</span>
                                    <div class="health-score health-unavailable">Not available</div>
                                    <div class="health-bar">
                                        <div class="health-progress health-unavailable-bar"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="analytics-card">
                            <h3>🎯 Financial Goals</h3>
                            <div class="goals-list loading-list">
                                <div class="loading-skeleton loading-row"></div>
                                <div class="loading-skeleton loading-row"></div>
                                <div class="loading-skeleton loading-row"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="dashboard-actions">
                    <a href="/upload" class="action-btn upload-btn">📎 Upload Preview</a>
                    <a href="/profile" class="action-btn primary-btn">✏️ View Profile</a>
                    <a href="/logout" class="action-btn secondary-btn">🚪 Logout</a>
                </div>
            </div>
        </div>
    </div>

    <style>
        .dashboard-wrapper {
            min-height: 100vh;
            background:
                radial-gradient(circle at 78% 12%, rgba(190, 238, 210, 0.8), transparent 16%),
                linear-gradient(135deg, #eefbf3 0%, #dcefe7 100%);
            color: #10251f;
        }

        .navbar {
            background: #10251f;
            color: #eefbf3;
            box-shadow: 0 12px 30px rgba(16, 37, 31, 0.12);
        }

        .navbar-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 24px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h2 {
            margin: 0;
            font-size: 26px;
            font-weight: 900;
            letter-spacing: -0.02em;
        }

        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .user-greeting {
            font-size: 14px;
            opacity: 0.9;
            color: #eefbf3;
        }

        .nav-link {
            color: #eefbf3;
            text-decoration: none;
            transition: opacity 0.3s ease;
            font-weight: 700;
        }

        .nav-link:hover {
            opacity: 0.82;
        }

        .logout-btn {
            background: #eefbf3;
            color: #10251f;
            padding: 10px 20px;
            border-radius: 999px;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid rgba(255,255,255,0.7);
            font-weight: 800;
        }

        .logout-btn:hover {
            background: #dff7ea;
        }

        .dashboard-container {
            padding: 40px 0;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            background: rgba(255,255,255,0.92);
            border-radius: 22px;
            padding: 25px;
            box-shadow: 0 12px 32px rgba(16,37,31,0.09);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(16,37,31,0.08);
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 32px rgba(16,37,31,0.12);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .card h3 {
            margin: 0;
            font-size: 14px;
            color: #666;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-icon {
            font-size: 24px;
        }

        .card-amount {
            font-size: 32px;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
        }

        .card-label {
            color: #999;
            font-size: 13px;
            margin: 0;
        }

        .account-card .card-amount { color: #0f7b54; }
        .income-card .card-amount { color: #3a815b; }
        .expense-card .card-amount { color: #b85b4e; }
        .savings-card .card-amount { color: #b3772b; }

        .analytics-section {
            margin-bottom: 40px;
        }

        .analytics-section h2 {
            color: #333;
            margin-bottom: 20px;
            font-size: 24px;
        }

        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .analytics-card {
            background: rgba(255,255,255,0.92);
            border-radius: 22px;
            padding: 25px;
            box-shadow: 0 12px 32px rgba(16,37,31,0.09);
            border: 1px solid rgba(16,37,31,0.08);
        }

        .analytics-card h3 {
            color: #10251f;
            margin: 0 0 20px 0;
            font-size: 18px;
            font-weight: 800;
        }

        .category-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .category-item {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .category-label {
            min-width: 140px;
            font-size: 14px;
            color: #555;
            font-weight: 500;
        }

        .category-bar {
            flex: 1;
            height: 8px;
            background: #e0e0e0;
            border-radius: 4px;
            overflow: hidden;
        }

        .category-progress {
            height: 100%;
            background: #0f7b54;
            border-radius: 4px;
        }

        .category-value {
            min-width: 70px;
            text-align: right;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .transactions-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .transaction {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            background: #f8f9fa;
            border-radius: 8px;
            transition: background 0.3s ease;
        }

        .transaction:hover {
            background: #f0f0f0;
        }

        .transaction-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .transaction-name {
            font-size: 14px;
            color: #333;
            font-weight: 500;
        }

        .transaction-date {
            font-size: 12px;
            color: #999;
        }

        .transaction-amount {
            font-weight: 700;
            font-size: 14px;
        }

        .transaction-amount.plus {
            color: #4caf50;
        }

        .transaction-amount.minus {
            color: #f44336;
        }

        .health-metrics {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .health-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .health-label {
            font-size: 13px;
            color: #666;
            font-weight: 500;
            text-transform: uppercase;
        }

        .health-score {
            font-size: 24px;
            font-weight: 700;
            color: #0f7b54;
        }

        .health-bar {
            height: 6px;
            background: #e0e0e0;
            border-radius: 3px;
            overflow: hidden;
        }

        .health-progress {
            height: 100%;
            background: #0f7b54;
            border-radius: 3px;
        }

        .health-unavailable {
            color: #999;
            font-size: 16px;
        }

        .health-unavailable-bar {
            width: 0;
            background: #d9dde2;
        }

        .goals-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .goal-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .goal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .goal-name {
            font-size: 14px;
            color: #333;
            font-weight: 500;
        }

        .goal-percentage {
            font-size: 14px;
            font-weight: 700;
            color: #0f7b54;
        }

        .goal-bar {
            height: 8px;
            background: #e0e0e0;
            border-radius: 4px;
            overflow: hidden;
        }

        .goal-progress {
            height: 100%;
            background: #0f7b54;
            border-radius: 4px;
        }

        .goal-details {
            font-size: 12px;
            color: #999;
        }

        .dashboard-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .action-btn {
            padding: 12px 24px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 800;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .primary-btn {
            background: #10251f;
            color: #eefbf3;
        }

        .primary-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 22px rgba(16,37,31,0.2);
        }

        .secondary-btn {
            background: #eefbf3;
            color: #10251f;
            border: 1px solid #10251f;
        }

        .secondary-btn:hover {
            background: #dff7ea;
            color: #10251f;
        }

        @media (max-width: 1024px) {
            .analytics-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <script>
        async function loadDashboardData() {
            const requests = [
                { name: 'Spending by category', url: '/api/analytics/spending-by-category', selector: '.category-list' },
                { name: 'Income and expenses', url: '/api/analytics/income-expenses', selector: '.account-card .card-amount' },
                { name: 'Transactions', url: '/api/analytics/transactions', selector: '.transactions-list' },
                { name: 'Financial goals', url: '/api/analytics/goals', selector: '.goals-list' },
                { name: 'Savings rate', url: '/api/analytics/savings-rate', selector: '.savings-card .card-amount' }
            ];

            document.getElementById('loading').style.display = 'none';
            document.getElementById('dashboard-main').style.display = 'block';

            const results = await Promise.all(requests.map((request) => runAnalyticsRequest(request)));
            const incomeExpenseResult = results[1];
            const savingsResult = results[4];
            if (incomeExpenseResult.status === 'fulfilled') updateAccountCards(incomeExpenseResult.value, savingsResult.status === 'fulfilled' ? savingsResult.value : {});
            if (results[0].status === 'fulfilled') updateSpendingChart(results[0].value);
            if (results[2].status === 'fulfilled') updateTransactions(results[2].value);
            if (results[3].status === 'fulfilled') updateGoals(results[3].value);
        }

        async function fetchAnalyticsData(request) {
            const response = await fetch(request.url);
            const data = await response.json();
            if (!response.ok) {
                throw new Error(data.error || `Request failed (${response.status})`);
            }
            return data;
        }

        async function runAnalyticsRequest(request, retryCount = 2) {
            const target = document.querySelector(request.selector);
            for (let attempt = 0; attempt <= retryCount; attempt += 1) {
                try {
                    const data = await fetchAnalyticsData(request);
                    clearAnalyticsError(target);
                    return { status: 'fulfilled', value: data };
                } catch (error) {
                    if (attempt === retryCount) {
                        console.error(`[Dashboard] ${request.name} failed after ${retryCount + 1} attempts:`, error);
                        showAnalyticsError(target, request);
                        return { status: 'rejected', reason: error };
                    }
                    await new Promise((resolve) => setTimeout(resolve, 750 * (attempt + 1)));
                }
            }
        }

        function showAnalyticsError(target, request) {
            if (!target) return;
            target.classList.remove('loading-list');
            target.innerHTML = `
                <div class="analytics-load-error">
                    <strong>Unable to load ${request.name.toLowerCase()}</strong>
                    <button type="button" class="retry-btn">Retry</button>
                </div>
            `;
            target.querySelector('.retry-btn').addEventListener('click', async (event) => {
                event.currentTarget.disabled = true;
                target.innerHTML = '<div class="loading-skeleton loading-row"></div>';
                const result = await runAnalyticsRequest(request, 2);
                if (result.status === 'fulfilled') {
                    if (request.name === 'Spending by category') updateSpendingChart(result.value);
                    if (request.name === 'Transactions') updateTransactions(result.value);
                    if (request.name === 'Financial goals') updateGoals(result.value);
                    if (request.name === 'Income and expenses') updateAccountCards(result.value, {});
                    if (request.name === 'Savings rate') updateAccountCards({}, result.value);
                }
            });
        }

        function clearAnalyticsError(target) {
            if (target) target.classList.remove('loading-list');
        }

        function updateAccountCards(incomeExpenseData, savingsData) {
            // Update balance card
            const balanceCard = document.querySelector('.account-card .card-amount');
            if (balanceCard) {
                balanceCard.textContent = '$' + (incomeExpenseData.balance || '0.00');
            }

            // Update income card
            const incomeCard = document.querySelector('.income-card .card-amount');
            if (incomeCard && incomeExpenseData.totalIncome !== undefined) {
                incomeCard.textContent = '$' + (incomeExpenseData.totalIncome || '0.00');
            }

            // Update expenses card
            const expenseCard = document.querySelector('.expense-card .card-amount');
            if (expenseCard && incomeExpenseData.totalExpenses !== undefined) {
                expenseCard.textContent = '$' + (Math.abs(incomeExpenseData.totalExpenses) || '0.00');
            }

            // Update savings rate card
            const savingsCard = document.querySelector('.savings-card .card-amount');
            if (savingsCard && savingsData.savingsRate !== undefined) {
                savingsCard.textContent = (savingsData.savingsRate || '0') + '%';
            }

            const healthSavings = document.querySelector('[data-health-savings]');
            const healthSavingsBar = document.querySelector('[data-health-savings-bar]');
            if (healthSavings && savingsData.savingsRate !== undefined) {
                const savingsRate = Number(savingsData.savingsRate) || 0;
                healthSavings.className = 'health-score';
                healthSavings.textContent = savingsRate.toFixed(1) + '%';
                healthSavingsBar.className = 'health-progress';
                healthSavingsBar.style.width = `${Math.max(0, Math.min(100, savingsRate))}%`;
            }
        }

        function updateSpendingChart(spendingData) {
            const chartContainer = document.querySelector('.category-list');
            if (!chartContainer || !spendingData.categories) return;

            const categories = spendingData.categories.slice(0, 5); // Top 5 categories
            const html = categories.map(cat => `
                <div class="category-item">
                    <div class="bar-label">${cat.category}</div>
                    <div class="category-bar">
                        <div class="category-progress" style="width: ${cat.percentage}%"></div>
                    </div>
                    <div class="category-value">$${cat.amount.toFixed(2)}</div>
                </div>
            `).join('');

            chartContainer.innerHTML = html;
        }

        function updateTransactions(transactionsData) {
            const transactionsContainer = document.querySelector('.transactions-list');
            if (!transactionsContainer || !transactionsData.transactions) return;

            const transactions = transactionsData.transactions.slice(0, 5); // Recent 5
            const html = transactions.map(tx => `
                <div class="transaction">
                    <div class="transaction-info">
                        <span class="transaction-name">${tx.description}</span>
                        <span class="transaction-date">${new Date(tx.date).toLocaleDateString()}</span>
                    </div>
                    <span class="transaction-amount ${tx.amount >= 0 ? 'plus' : 'minus'}">
                        ${tx.amount >= 0 ? '+' : ''}$${Math.abs(tx.amount).toFixed(2)}
                    </span>
                </div>
            `).join('');

            transactionsContainer.innerHTML = html;
        }

        function updateGoals(goalsData) {
            const goalsContainer = document.querySelector('.goals-list');
            if (!goalsContainer || !goalsData.goals) return;

            const goals = goalsData.goals.slice(0, 3); // Top 3 goals
            const html = goals.map(goal => {
                const progress = (goal.currentAmount / goal.targetAmount) * 100;
                return `
                    <div class="goal-item">
                        <div class="goal-header">
                            <span class="goal-name">${goal.goalName}</span>
                            <span class="goal-progress">${progress.toFixed(1)}%</span>
                        </div>
                        <div class="goal-bar">
                            <div class="goal-progress" style="width: ${progress}%"></div>
                        </div>
                        <div class="goal-amounts">
                            <span>$${goal.currentAmount} / $${goal.targetAmount}</span>
                        </div>
                    </div>
                `;
            }).join('');

            goalsContainer.innerHTML = html;
        }

        // Load data when page loads
        document.addEventListener('DOMContentLoaded', loadDashboardData);
    </script>
</body>
</html>
